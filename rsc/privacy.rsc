21:["$","div",null,{"className":"flex flex-col gap-4","children":["$","p",null,{"className":"text-drift leading-relaxed","children":"Krillion isn’t directed at children under 13 and we don’t knowingly collect personal information from them. If you believe a child has given us personal information, email us and we’ll delete it."}]}]
