2e:["$","p",null,{"className":"text-drift leading-relaxed","children":["If you would like more information about this practice and to know your choices to opt-in or opt-out of this data collection, please visit"," ",["$","a",null,{"href":"https://thenai.org/opt-out/","className":"underline text-drift hover:text-lumen-cyan","children":"National Advertising Initiative opt out page"}],". You may also visit"," ",["$","a",null,{"href":"http://optout.aboutads.info/#/","className":"underline text-drift hover:text-lumen-cyan","children":"Digital Advertising Alliance website"}]," ","and"," ",["$","a",null,{"href":"http://optout.networkadvertising.org/#","className":"underline text-drift hover:text-lumen-cyan","children":"Network Advertising Initiative website"}]," ","to learn more information about interest-based advertising. You may download the AppChoices app at"," ",["$","a",null,{"href":"https://youradchoices.com/appchoices","className":"underline text-drift hover:text-lumen-cyan","children":"Digital Advertising Alliance’s AppChoices app"}]," ","to opt out in connection with mobile apps, or use the platform controls on your mobile device to opt out."]}]
